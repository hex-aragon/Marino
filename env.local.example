# SeaWatch — environment variables
# Copy this file to .env.local and fill in your own values.
# (This file is shipped as env.local.example because dotfiles with secrets
#  are blocked by the sandbox; rename to .env.local.example after cloning.)

# AIS — sign up free at https://aisstream.io
AISSTREAM_API_KEY=your_aisstream_api_key_here

# Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Solana
NEXT_PUBLIC_SOLANA_NETWORK=devnet
# base58-encoded private key of the fee payer keypair (devnet/local dev only)
SOLANA_FEE_PAYER_PRIVATE_KEY=
# Solana wallet address that receives subscription & marketplace payments
NEXT_PUBLIC_MERCHANT_WALLET=

# Vercel KV (Redis) — optional, used for caching ships & alerts
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Resend — optional, used to send HIGH-level alert emails
RESEND_API_KEY=
